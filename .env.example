# ==============================================================================
# Conversational Data Analysis Assistant (HCL P_123) - Environment Configuration
# ==============================================================================

# Application & Flask Server Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key
PORT=5000
HOST=0.0.0.0

# Active LLM Provider Selection: "ollama", "gemini", "groq", or "mock"
LLM_PROVIDER=ollama

# Provider 1: Local Ollama (Offline / Zero-cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Provider 2: Google Gemini (Free Tier API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Provider 3: Groq Cloud (High-Speed Inference)
# Get your API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
